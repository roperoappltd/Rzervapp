msgstr "Maisonnette à Abidjan"

#: app/templates/pages/aboutus.html:167
msgid ""
"The Diaby's familly occupying their Jambo booked property\n"
"              for 2 weeks."
msgstr ""
"La famille Diaby occupant sa propriété réservée via Jambo pendant 2 "
"semaines."

#: app/templates/pages/aboutus.html:188
msgid "Flat at Pretoria"
msgstr "Appartement à Pretoria"

#: app/templates/pages/aboutus.html:190
