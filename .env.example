# Copy this file to .env and fill in real values.
# .env itself should NEVER be committed to git -- confirm it's listed
# in .gitignore before creating the real one.

# ---------------- Flask ----------------
APP_SECRET_KEY=generate-a-long-random-string-here

# ---------------- Database ----------------
# Reusing the existing shared MariaDB (Nextcloud_database container),
# in its own separate "jambo_db" database with its own scoped user --
# see the CREATE DATABASE/CREATE USER commands from earlier.
# host.docker.internal, NOT localhost/127.0.0.1 -- from inside
# jambo_web's own container, those would mean the container itself,
# not the VPS host where MariaDB's port is actually published.
DATABASE_URL=mysql+pymysql://jambo_user:CHANGE_ME@host.docker.internal:3308/jambo_db

# ---------------- Email ----------------
EMAIL_USER=your-email@example.com
EMAIL_PASS=your-email-app-password

# ---------------- External APIs ----------------
ANTHROPIC_API_KEY=
XCHANGE_RATE_API_KEY=

# ---------------- Image storage ----------------
# "local" or "cloudinary" -- see the earlier note about local storage
# not persisting across container rebuilds unless a volume is mounted.
IMAGE_BACKEND=local
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=
